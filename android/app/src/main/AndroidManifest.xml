<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The native offline screen asks ConnectivityManager whether a network
         exists before it offers a retry, and listens for one coming back so it
         can recover without a tap. Both need this; it is not runtime-granted. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Clock-in is geofence-gated. The WebView's navigator.geolocation routes
         straight to Android's location services, and Capacitor's
         BridgeWebChromeClient.onGeolocationPermissionsShowPrompt already
         requests these two at the moment the page first calls getCurrentPosition
         / watchPosition. Declaring BOTH is required, not optional: Android 12+
         shows the Precise / Approximate toggle only when FINE and COARSE are
         requested together, and a permission absent from the manifest is
         auto-denied without a prompt.
         Approximate-only (COARSE granted, FINE refused) still returns a
         position — at 1-3km accuracy, which reads as out of range against a
         250m geofence. The web UI needs to name that case specifically. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Shift reminders arrive as native FCM pushes. The push-notifications
         plugin annotates POST_NOTIFICATIONS for its runtime request, but does
         NOT declare it in its own manifest - and Android auto-denies a
         permission missing from the merged manifest, with no prompt shown. On
         API 33+ requestPermissions() goes through requestPermissionForAlias,
         so without this line every app user would silently have reminders off.
         Same trap as the location permissions in Update 3. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A device with no GPS hardware can still use the app for everything
         except clocking in, so location must not become an install filter. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
</manifest>
