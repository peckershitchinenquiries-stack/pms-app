{
  "name": "pms-mobile",
  "version": "0.1.0",
  "description": "Capacitor Android + iOS shell for the Peckers web app (remote mode — no business logic)",
  "scripts": {
    "sync": "cap sync android",
    "sync:ios": "cap sync ios",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --android",
    "assets:ios": "capacitor-assets generate --ios",
    "env:lan": "node scripts/use-env.mjs lan",
    "env:preview": "node scripts/use-env.mjs preview",
    "env:prod": "node scripts/use-env.mjs prod",
    "build:debug": "cd android && gradlew.bat assembleDebug",
    "build:release": "cd android && gradlew.bat assembleRelease",
    "bundle:release": "cd android && gradlew.bat bundleRelease"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
