<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android 9+ blocks cleartext by default, so server.cleartext alone is
         not enough to reach the dev server. Scoped to the dev hosts only;
         everything else still requires HTTPS.
         Update the 192.168.* entry whenever the machine's DHCP address changes.

         `localhost` is the one that matters now: it is the only cleartext
         origin Chromium treats as a SECURE CONTEXT, so it is the only way
         navigator.geolocation works against a local dev server. It reaches
         this machine via `adb reverse tcp:3000 tcp:3000` over USB. The LAN
         address is kept for everything that does not need location. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.31.177</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
