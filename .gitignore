# Dependencies
node_modules/

# Release signing — NEVER commit. Losing these means no installed APK can
# ever be updated again; the keystore is backed up outside this repo.
*.keystore
*.jks
keystore.properties
android/keystore.properties

# Firebase config (added in Task 5 for push); carries project identifiers
google-services.json

# Android build output / machine-local paths
android/local.properties
android/.gradle/
android/app/build/
android/build/
android/captures/
build/
*.apk
*.aab

# Capacitor copies the webDir into here on sync
android/app/src/main/assets/public/

# Editor / OS
.idea/
*.iml
.DS_Store
Thumbs.db

# iOS signing material — same rule as the Android keystore: never committed.
# Certificates and profiles are issued per Apple account and are re-downloadable,
# but a committed .p12 hands anyone the ability to sign as us.
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
ios/App/App/GoogleService-Info.plist

# iOS build output (ios/.gitignore covers App/build, App/Pods, DerivedData)
*.ipa
*.xcarchive
